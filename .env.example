# Environment Variables Template
# Copy this file to .env.local and update with your actual values

# ==========================================
# API CONFIGURATION
# ==========================================

VITE_API_BASE_URL=http://localhost:5035/api
VITE_IMG_BASE_URL=http://localhost:5035
# ==========================================
# SEEDER CONFIGURATION (Optional)
# ==========================================
# Controls whether database seeders run on app startup
# Set to 'true' for new installations, 'false' after seeding
# Default: false (seeders disabled for safety)
# 
# IMPORTANT: Create .env.local (not committed to git) to use this
# See SEEDER_README.md for complete documentation
#
# VITE_ENABLE_SEEDERS=false

# ==========================================
# APP CONFIGURATION (Optional)
# ==========================================
# VITE_APP_NAME=MIST Admin Portal
# VITE_APP_VERSION=1.0.0
# VITE_APP_ENV=development

